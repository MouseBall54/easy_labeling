{
  "name": "easy_labeling",
  "version": "26.8.21",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "node scripts/copy-offline-assets.mjs",
    "prestart": "npm run build",
    "start": "npm run serve",
    "serve": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "dev": "concurrently -k \"npm:build:watch\" \"npm:serve\"",
    "test": "npm run test:unit",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "benchmark:template-matching": "node scripts/benchmark-template-matching.mjs",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --win --x64 --dir",
    "electron:dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "keywords": [],
  "author": "박영문",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Desktop image annotation tool for detection and segmentation labeling.",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "canvas": "file:stubs/canvas",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "global-agent": "file:stubs/global-agent",
    "jsdom": "file:stubs/jsdom",
    "rcedit": "^5.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "fabric": "^7.4.0",
    "tiff.js": "^1.0.0"
  },
  "overrides": {
    "@electron/asar": "^4.2.0",
    "@electron/rebuild": "^4.0.4",
    "rimraf": "^6.1.3"
  },
  "build": {
    "appId": "com.easylabeling.desktop",
    "productName": "Easy Labeling",
    "afterPack": "scripts/after-pack.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "privacy.html",
      "privacy_ko.html",
      "assets/**/*",
      "css/**/*",
      "dist/**/*",
      "vendor/**/*",
      "workers/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icons/easy-labeling.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

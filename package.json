{
  "name": "easy_labeling",
  "version": "2.27.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "yoloe:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-yoloe.ps1",
    "yoloe:prepare": "uv run --project runtime/yoloe --locked python runtime/yoloe/backend.py prepare",
    "yoloe:models:record": "node scripts/record-yoloe-models.mjs",
    "yoloe:export:onnx": "uv run --project runtime/yoloe --locked --group export python scripts/export-yoloe-onnx.py",
    "yoloe:check": "uv run --project runtime/yoloe --locked python runtime/yoloe/backend.py check",
    "yoloe:test": "uv run --project runtime/yoloe --locked python -m unittest discover -s runtime/yoloe -p test_backend.py",
    "yoloe:start": "uv run --project runtime/yoloe --locked python runtime/yoloe/backend.py serve",
    "copy:offline-assets": "node scripts/copy-offline-assets.mjs",
    "prebuild": "npm run copy:offline-assets",
    "predev": "npm run copy:offline-assets",
    "preserve": "npm run copy:offline-assets",
    "prestart": "npm run build",
    "start": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "serve": "npm run build && vite --host 0.0.0.0 --port 4173 --strictPort",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "dev": "npm run build && concurrently -k \"npm:build:watch\" \"vite --host 0.0.0.0 --port 4173 --strictPort\"",
    "test": "npm run test:unit",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "benchmark:template-matching": "node scripts/benchmark-template-matching.mjs",
    "tauri:dev": "tauri build --debug --no-bundle",
    "tauri:dist:win": "tauri build",
    "tauri:dist:yoloe:win": "npm run yoloe:models:record && tauri build --config src-tauri/tauri.yoloe.conf.json",
    "release:tauri": "node scripts/release-tauri.mjs"
  },
  "keywords": [],
  "author": "박영문",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Desktop image annotation tool for detection and segmentation labeling.",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.12.2",
    "canvas": "file:stubs/canvas",
    "concurrently": "^9.2.1",
    "jsdom": "file:stubs/jsdom",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "fabric": "^7.4.0",
    "onnxruntime-web": "1.29.0",
    "tiff.js": "^1.0.0"
  }
}

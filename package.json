{
  "name": "easy_labeling",
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "yoloe:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-yoloe.ps1",
    "yoloe:prepare": "uv run --project runtime/yoloe --locked python runtime/yoloe/backend.py prepare",
    "yoloe:models:record": "node scripts/record-yoloe-models.mjs",
    "yoloe:export:onnx": "uv run --project runtime/yoloe --locked --group export python scripts/export-yoloe-onnx.py",
    "yoloe:check": "uv run --project runtime/yoloe --locked python runtime/yoloe/backend.py check",
    "yoloe:test": "uv run --project runtime/yoloe --locked python -m unittest discover -s runtime/yoloe -p test_backend.py",
    "yoloe:start": "uv run --project runtime/yoloe --locked python runtime/yoloe/backend.py serve",
    "copy:offline-assets": "node scripts/copy-offline-assets.mjs",
    "prebuild": "npm run copy:offline-assets",
    "predev": "npm run copy:offline-assets",
    "preserve": "npm run copy:offline-assets",
    "prestart": "npm run build",
    "start": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "serve": "npm run build && vite --host 0.0.0.0 --port 4173 --strictPort",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "dev": "npm run build && concurrently -k \"npm:build:watch\" \"vite --host 0.0.0.0 --port 4173 --strictPort\"",
    "test": "npm run test:unit",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "benchmark:template-matching": "node scripts/benchmark-template-matching.mjs",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --win --x64 --dir",
    "electron:dist:win": "npm run build && electron-builder --win nsis --x64",
    "electron:dist:yoloe:win": "npm run build && npm run yoloe:models:record && electron-builder --config electron-builder.yoloe.cjs --win nsis --x64"
  },
  "keywords": [],
  "author": "박영문",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Desktop image annotation tool for detection and segmentation labeling.",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "canvas": "file:stubs/canvas",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "global-agent": "file:stubs/global-agent",
    "jsdom": "file:stubs/jsdom",
    "rcedit": "^5.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "fabric": "^7.4.0",
    "onnxruntime-web": "1.29.0",
    "tiff.js": "^1.0.0"
  },
  "overrides": {
    "@electron/asar": "^4.2.0",
    "@electron/rebuild": "^4.0.4",
    "rimraf": "^6.1.3"
  },
  "build": {
    "appId": "com.easylabeling.desktop",
    "productName": "Easy Labeling",
    "afterPack": "scripts/after-pack.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "docs/YOLOE26_GPU_KO.md",
      "docs/YOLOE26_VALIDATION_20261004_KO.md",
      "privacy.html",
      "privacy_ko.html",
      "assets/**/*",
      "!assets/models/yoloe26/**/*",
      "css/**/*",
      "dist/**/*",
      "vendor/**/*",
      "workers/**/*",
      "electron/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/sample/**/*"
    ],
    "win": {
      "icon": "assets/icons/easy-labeling.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
